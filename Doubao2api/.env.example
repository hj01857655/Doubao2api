# Doubao2api 配置模板：复制为 .env 后填入真实值（.env 不入库）

# ---- 上游凭证（必须） ----
# 登录 https://www.doubao.com 后 F12 -> Network -> completion 请求 -> 复制 Cookie。
# 只需 10 个 cookie 名（sessionid/sessionid_ss/sid_tt/sid_guard/uid_tt/uid_tt_ss/
# d_ticket/ttwid/s_v_web_id/passport_csrf_token），docs/05 §1.2 有裁剪说明。
DOUBAO_COOKIE="sessionid=...; sessionid_ss=...; sid_tt=...; sid_guard=...; uid_tt=...; uid_tt_ss=...; d_ticket=...; ttwid=...; s_v_web_id=...; passport_csrf_token=..."
# 或者：启动服务后打开 http://127.0.0.1:8378/login 用豆包 App 扫码，本行会被自动改写（无需重启）。

# ---- 入站鉴权（可选） ----
# 设了则要求 Authorization: Bearer <key> 或 x-api-key: <key>；不设 = 本地裸奔模式。
# API_KEY=sk-local-please-change

# ---- 服务 ----
# PORT=8378

# ---- 设备常量（可选，默认取自逆向实测值） ----
# DOUBAO_DEVICE_ID=854749611058841
# DOUBAO_WEB_ID=7696568307852379690
# DOUBAO_PC_VERSION=2.32.5
# DOUBAO_CHROMIUM_VERSION=147.0.7727.149
# DOUBAO_BOT_ID=7338286299411103781
